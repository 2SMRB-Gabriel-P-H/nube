@echo off
setlocal
set "NUBE_KEY_PATH=%~dp0..\nube_master.key"
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; $p=[IO.Path]::GetFullPath($env:NUBE_KEY_PATH); if(Test-Path -LiteralPath $p){Write-Error 'Ya existe una clave; no se ha cambiado.'; exit 1}; $rng=[Security.Cryptography.RandomNumberGenerator]::Create(); $bytes=New-Object byte[] 32; $rng.GetBytes($bytes); $data=[Text.Encoding]::UTF8.GetBytes(([Convert]::ToBase64String($bytes)+[Environment]::NewLine)); $stream=$null; try{$stream=[IO.File]::Open($p,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::None); $stream.Write($data,0,$data.Length); $stream.Flush()} finally{if($null -ne $stream){$stream.Dispose()}; $rng.Dispose(); [Array]::Clear($bytes,0,$bytes.Length); [Array]::Clear($data,0,$data.Length)}; $accounts=@((whoami),'SYSTEM','*S-1-5-32-544'); $services=@(Get-CimInstance Win32_Service | Where-Object {$_.PathName -match '(?i)apache|httpd'}); foreach($service in $services){if($service.StartName -and $service.StartName -notmatch '^(LocalSystem|NT AUTHORITY\\SYSTEM)$'){$accounts+=$service.StartName}}; $accounts=$accounts|Select-Object -Unique; & icacls.exe $p /inheritance:r | Out-Null; if($LASTEXITCODE -ne 0){throw 'No se pudieron restringir los permisos de la clave.'}; foreach($account in $accounts){$perm=if($account -eq (whoami) -or $account -eq 'SYSTEM' -or $account -eq '*S-1-5-32-544'){'F'}else{'R'}; $grant=('{0}:({1})' -f $account,$perm); & icacls.exe $p /grant:r $grant | Out-Null; if($LASTEXITCODE -ne 0){Write-Warning ('No se pudo asignar permiso a '+$account)}}; Write-Output 'Clave creada correctamente.'"
if errorlevel 1 exit /b 1
endlocal
